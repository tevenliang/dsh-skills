  "tools": {
    "web_search": {
      "id": "web_search",
      "name": "Brave Search (Built-in)",
      "type": "system",
      "strengths": [
        "general",
        "english",
        "news",
        "technical"
      ],
      "coverage": "global",
      "freshness": "realtime",
      "depth": "surface",
      "cost": "free",
      "estimated_latency_ms": 1500,
      "detection": {
        "type": "builtin",
        "note": "OpenClaw 内置系统工具，始终可用"
      },
      "call": {
        "kind": "system_tool",
        "tool_name": "web_search",
        "params": {
          "query": "string (required)",
          "count": "1-10 (default 5)",
          "freshness": "day|week|month|year (optional)",
          "country": "2-letter code (optional)"
        }
      }
    },
    "web_fetch": {
      "id": "web_fetch",
      "name": "URL Content Extractor (Built-in)",
      "type": "system",
      "strengths": [
        "deep_extract",
        "verification",
        "full_text"
      ],
      "coverage": "global",
      "freshness": "realtime",
      "depth": "deep",
      "cost": "free",
      "estimated_latency_ms": 2000,
      "detection": {
        "type": "builtin",
        "note": "OpenClaw 内置系统工具，始终可用"
      },
      "call": {
        "kind": "system_tool",
        "tool_name": "web_fetch",
        "params": {
          "url": "string (required)",
          "extractMode": "markdown|text (default markdown)",
          "maxChars": "number (optional)"
        }
      }
    },
    "browser": {
      "id": "browser",
      "name": "Browser Automation (Built-in)",
      "type": "system",
      "strengths": [
        "dynamic_pages",
        "interaction",
        "screenshot",
