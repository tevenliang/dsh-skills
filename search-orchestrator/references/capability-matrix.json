    "baidu-search": {
      "id": "baidu-search",
      "name": "Baidu AI Search",
      "type": "skill",
      "strengths": [
        "chinese",
        "news",
        "general",
        "china_coverage"
      ],
      "coverage": "china",
      "freshness": "realtime",
      "depth": "moderate",
      "cost": "paid",
      "estimated_latency_ms": 2000,
      "detection": {
        "type": "skill_scan",
        "directory": "baidu-search",
        "check_env": [
          "BAIDU_API_KEY"
        ],
        "check_bins": [
          "python3"
        ],
        "check_files": [
          "scripts/search.py"
        ]
      },
      "call": {
        "kind": "shell",
        "template": "cd {skill_dir} && BAIDU_API_KEY=$BAIDU_API_KEY python3 scripts/search.py <JSON>",
        "params": {
          "query": "string (required)",
          "count": "1-50 (default 10)",
          "freshness": "YYYY-MM-DDtoYYYY-MM-DD | pd|pw|pm|py (optional)"
        }
      }
    },
    "tavily-search": {
      "id": "tavily-search",
      "name": "Tavily AI Search",
      "type": "skill",
      "strengths": [
        "english",
        "deep_research",
        "news",
        "ai_optimized"
      ],
      "coverage": "global",
      "freshness": "realtime",
      "depth": "deep",
      "cost": "paid",
      "estimated_latency_ms": 2000,
      "detection": {
        "type": "skill_scan",
        "directory": "openclaw-tavily-search",
        "check_env": [
          "TAVILY_API_KEY"
        ],
        "check_bins": [
          "python3"
        ],
        "check_files": [
          "scripts/tavily_search.py"
        ]
      },
      "call": {
        "kind": "shell",
        "template": "cd /Users/tianwenliang/.agents/skills/Search/tavily-search && TAVILY_API_KEY=$TAVILY_API_KEY python3 scripts/tavily_search.py '<QUERY>' --depth advanced --max-results 10",
        "params": {
          "<QUERY>": "string (required)",
          "options": "--depth advanced --max-results 10"
        }
      }
    },
    "minimax-web-search": {
      "id": "minimax-web-search",
      "name": "MiniMax Token Plan Web Search",
      "type": "skill",
      "strengths": [
        "chinese",
        "general",
        "image_understanding"
      ],
      "coverage": "china+global",
      "freshness": "realtime",
      "depth": "moderate",
      "cost": "token",
