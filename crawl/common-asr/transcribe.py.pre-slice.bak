    from common_supervisor._eagain_retry import popen_with_retry, run_with_retry
except ImportError:
    # fallback: 用原生 Popen/run (但 EAGAIN 会直接抛)
    popen_with_retry = subprocess.Popen
    run_with_retry = subprocess.run

