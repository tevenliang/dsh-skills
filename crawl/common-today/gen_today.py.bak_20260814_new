#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
gen_today.py — 生成当日每日汇总 md

H1=平台 | H2=博主 | H3=文章标题 | 正文用 ![[]] 嵌入
嵌入路径中 # 编码为 %23（避免 Obsidian 解析为标题锚点）

2026-08-14 fix: 匹配逻辑改为「文件修改时间 / frontmatter created 字段」
（而非文件名日期），确保 VM 异步转录的文章进入处理当天 index。
"""
import re, sys, os
from datetime import date, datetime, timezone, timedelta
from pathlib import Path

TZ = timezone(timedelta(hours=8))
VAULT_ROOT = Path(os.environ.get("VAULT", "/Users/tianwenliang/Documents/steven_vault"))
SUBSCRIPTION_DIR = VAULT_ROOT / "subscription"

PLATFORM_GROUPS = {
    "douyin":      "抖音",
    "bilibili":    "B站",
    "xiaohongshu": "小红书",
    "boss":        "Boss",
    "jd":          "JD",
    "linkedin":    "领英",
    "tieba":       "贴吧",
    "wechat":      "微信",
}

SKIP_PATTERNS = [r"^hot-archive-", r"^\.", r"^_"]

def should_skip(name):
    return any(re.match(p, name) for p in SKIP_PATTERNS)


def _parse_frontmatter_created(fpath: Path):
    """读 md frontmatter 的 created 字段，返回 date 或 None"""
    try:
        text = fpath.read_text(encoding="utf-8", errors="ignore")
    except Exception:
        return None
    if not text.startswith("---"):
        return None
    end = text.find("\n---\n", 4)
    if end < 0:
        return None
    import yaml
    try:
        fm = yaml.safe_load(text[4:end])
    except Exception:
        return None
    created_raw = fm.get("created") if isinstance(fm, dict) else None
    if not created_raw:
        return None
    # 支持 ISO 格式 "2026-08-13T23:32:28.096782+08:00" 或 "2026-08-13"
    s = str(created_raw)
    for fmt in ("%Y-%m-%dT%H:%M:%S%z", "%Y-%m-%dT%H:%M:%S.%f%z",
                "%Y-%m-%dT%H:%M:%S", "%Y-%m-%d"):
        try:
            dt = datetime.strptime(s[:len("2026-08-13T23:32:28")], fmt)
            return dt.astimezone(TZ).date()
        except Exception:
            pass
    return None


def _file_mtime_date(fpath: Path) -> date:
    """返回文件的修改时间（date 部分）"""
    from datetime import datetime as dt2
    t = fpath.stat().st_mtime
    return dt2.fromtimestamp(t, tz=TZ).date()


def _date_in_target(created_date, mtime_date, target: date):
    """判断文章是否属于 target 日期：优先 created 字段，否则用 mtime"""
    check = created_date or mtime_date
    return check == target


def title_from_file(name):
    name = re.sub(r"^\d{4}-\d{2}-\d{2}[_-]", "", name)
    name = re.sub(r"^\d{2,4}[_-]", "", name)
    name = re.sub(r"\.(md|MD)$", "", name)
    name = re.sub(r"[_-]+", " ", name).strip()
    return name or "无标题"


def embed_path(platform, author, fname):
    """生成 Obsidian embed 路径，# 编码为 %23"""
    if author:
        base = f"subscription/{platform}/{author}/{fname}"
    else:
        base = f"subscription/{platform}/{fname}"
    return base.replace("#", "%23")


def scan_platform(platform, target_date):
    """扫描指定平台下属于 target_date 的文章。
    匹配规则：frontmatter created 字段 == target_date；无 created 则用文件 mtime。
    """
    results = []
    pdir = SUBSCRIPTION_DIR / platform
    if not pdir.is_dir():
        return results
    for item in sorted(pdir.iterdir()):
        if item.is_dir():
            for sub in sorted(item.iterdir()):
                if sub.is_file() and sub.suffix == ".md" and not should_skip(sub.name):
                    created = _parse_frontmatter_created(sub)
                    mtime = _file_mtime_date(sub)
                    if _date_in_target(created, mtime, target_date):
                        results.append((item.name, sub.name))
        elif item.is_file() and item.suffix == ".md" and not should_skip(item.name):
            created = _parse_frontmatter_created(item)
            mtime = _file_mtime_date(item)
            if _date_in_target(created, mtime, target_date):
                results.append(("", item.name))
    return results


def generate(target_date):
    """生成每日汇总，按平台→博主→帖子三级结构"""
    if isinstance(target_date, str):
        target_date = date.fromisoformat(target_date)

    lines = []
    total = 0
    for platform, group_name in PLATFORM_GROUPS.items():
        items = scan_platform(platform, target_date)
        if not items:
            continue
        lines.append(f"# {group_name}")
        author_items = {}
        for author, fname in items:
            if author not in author_items:
                author_items[author] = []
            author_items[author].append(fname)
        for author, fnames in sorted(author_items.items()):
            h2 = author or group_name
            lines.append(f"\n## {h2}")
            for fname in fnames:
                title = title_from_file(fname)
                lines.append(f"\n### {title}")
                lines.append(f"\n![[{embed_path(platform, author, fname)}]]")
                total += 1
    return "\n".join(lines).strip(), total


def main():
    target = sys.argv[1] if len(sys.argv) > 1 else date.today().strftime("%Y-%m-%d")
    target_ymd = date.fromisoformat(target)
    date_str = target[5:].replace("-", "")
    out = SUBSCRIPTION_DIR / f"{date_str}-index.md"
    content, n = generate(target_ymd)
    out.write_text(content + "\n", encoding="utf-8")
    print(f"✅ {out.name}，共 {n} 篇")


if __name__ == "__main__":
    main()
