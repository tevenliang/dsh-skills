#!/bin/bash
# usage-check 统一入口
set -u

if [[ -n "${BASH_SOURCE[0]:-}" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
else
    SCRIPT_DIR="/Users/tianwenliang/.agents/skills/System/usage-check/scripts"
fi

MODULE="${1:-all}"
MODE="${2:-human}"
VALID_MODULES=("minimax" "tavily" "deepseek" "vm" "bailian" "bailian-guard" "all")

[[ ! " ${VALID_MODULES[*]} " =~ " ${MODULE} " ]] && { echo "❌ 未知模块: $MODULE"; exit 2; }
[[ "$MODE" != "human" && "$MODE" != "json" ]] && { echo "❌ 未知模式: $MODE"; exit 2; }

BAILIAN_CHECK="$SCRIPT_DIR/bailian-check.sh"
BAILIAN_GUARD="$SCRIPT_DIR/bailian-quota-guard.sh"

run_module() {
    case $1 in
        minimax)      echo "$SCRIPT_DIR/minimax-check.sh" ;;
        tavily)       echo "$SCRIPT_DIR/tavily-check.sh" ;;
        deepseek)     echo "$SCRIPT_DIR/deepseek-check.sh" ;;
        vm)           echo "$SCRIPT_DIR/vm-check.py" ;;
        bailian)      echo "$BAILIAN_CHECK" ;;
        bailian-guard)echo "$BAILIAN_GUARD" ;;
        *)            echo "" ;;
    esac
}

fmt_minimax_human() {
    python3 -c "
import json,sys
data=json.loads('''$1''')
print('=== MiniMax 用量 ===')
if 'error' in data: print('⚠️  '+data['error']);sys.exit(0)
for m in data.get('models',[]):
    print('【'+m['model']+'】')
    w5=m['5h_window']
    print('  ⏰ 5h窗口: '+w5['start_time']+' ~ '+w5['end_time']+' ('+w5['status_text']+') | 剩余 '+w5['remaining_time'])
    print('  📊 5h用量: '+str(w5['used_percent'])+'% 已用 | '+str(w5['remaining_percent'])+'% 剩 | '+w5['health_emoji']+' '+w5['health'])
    ww=m['weekly_window']
    boost=(' | +'+str(ww['boost_percent'])+'%') if ww.get('boost_percent') else ''
    print('  📅 本周窗口: '+ww['start_time']+' ~ '+ww['end_time']+' ('+ww['status_text']+') | 剩余 '+ww['remaining_time']+boost)
    print('  📈 本周用量: '+str(ww['used_percent'])+'% 已用 | '+str(ww['remaining_percent'])+'% 剩 | '+ww['health_emoji']+' '+ww['health'])
print('  ⏱️ 抓取时间: '+data.get('fetched_at','?'))
"
}

fmt_tavily_human() {
    python3 -c "
import json,sys
data=json.loads('''$1''')
print('=== Tavily 用量 ===')
if 'error' in data: print('⚠️  '+data['error']);sys.exit(0)
print('📡 Tavily ['+data['plan']+']')
print('   已用: '+str(data['used'])+' / '+str(data['limit'])+' ('+str(data['used_percent'])+'%)')
print('   剩余: '+str(data['remaining'])+' credits')
print('   搜索消耗: '+str(data['search_usage'])+' credits')
print('   健康度: '+data['health_emoji']+' '+data['health'])
print('   ⏱️ 抓取时间: '+data.get('fetched_at','?'))
"
}

fmt_deepseek_human() {
    python3 -c "
import json,sys
data=json.loads('''$1''')
print('=== DeepSeek 余额 ===')
if data.get('disabled'): print('⚪ 已禁用: '+data['reason']);print('   启用: '+data.get('enable_command','SHOW_DEEPSEEK=1'));sys.exit(0)
if 'error' in data: print('⚠️  '+data['error']);sys.exit(0)
print('🤖 DeepSeek ['+data['currency']+'] '+data['status_emoji']+' '+data['status_text'])
print('   '+data['health_emoji']+' 总余额: ¥'+data['total_balance'])
print('   🎁 赠金: ¥'+data['granted_balance'])
print('   💵 现金: ¥'+data['topped_up_balance'])
print('   ⏱️ 抓取时间: '+data.get('fetched_at','?'))
"
}

fmt_vm_human() {
    python3 -c "
import json,sys
data=json.loads('''$1''')
print('=== VM (Hermes) 状态 ===')
if 'error' in data: print('⚠️  '+data['error']+' ['+data.get('host','')+']');sys.exit(0)
d=data['disk'];m=data['memory'];c=data['cpu']
print('💾 硬盘 ['+str(d['total_gb'])+'G total]')
print('   已用: '+str(d['used_gb'])+'G / '+str(d['total_gb'])+'G ('+str(d['used_percent'])+'%) | 剩余 '+str(d['avail_gb'])+'G | '+d['health_emoji']+' '+d['health'])
print('🧠 内存 ['+str(m['total_mb'])+'M total]')
print('   已用: '+str(m['used_mb'])+'M / '+str(m['total_mb'])+'M ('+str(m['used_percent'])+'%) | 可用 '+str(m['avail_mb'])+'M | '+m['health_emoji']+' '+m['health'])
print('⚙️  CPU [使用 '+str(c['used_percent'])+'% | load '+c['load_avg']+'] | '+c['health_emoji']+' '+c['health'])
print('   ⏱️ 抓取时间: '+data.get('fetched_at','?'))
"
}

fmt_bailian_human() {
    python3 -c "
import json,sys
data=json.loads('''$1''')
print('=== Bailian 百炼免费额度 ===')
print('抓取: '+data.get('fetched_at','?'))
print()
print('| Combo | 模型 | 已用 | 剩余 | 额度% | 健康 |')
print('|-------|------|------|------|-------|------|')
for m in data.get('models',[]):
    combo = m.get('combo','?')
    model = m['model']
    if m.get('in_free_list'):
        used_str = str(m['used'])
        rem_str  = str(m['remaining'])
        pct_str  = str(round(m['pct'],1))+'%'
        h = m['health']; ht = m['health_text']
    else:
        used_str = '-'; rem_str = '-'; pct_str = '-'
        h = m['health']; ht = m['health_text']
    print('| '+combo+' | '+model+' | '+used_str+' | '+rem_str+' | '+pct_str+' | '+h+' '+ht+' |')
"
}

if [[ "$MODULE" == "all" ]]; then
    if [[ "$MODE" == "json" ]]; then
        MINI=$(bash "$(run_module minimax)")
        TAVI=$(bash "$(run_module tavily)")
        DEEP=$(bash "$(run_module deepseek)" 2>/dev/null || echo '{"disabled":true}')
        VMRAW=$(python3 "$(run_module vm)" 2>/dev/null || echo '{"error":"vm failed"}')
        BAILIAN=$(python3 "$BAILIAN_CHECK" 2>/dev/null || echo '{"error":"bailian-check failed"}')
        python3 -c "
import json
m=json.loads('''$MINI''');t=json.loads('''$TAVI''');d=json.loads('''$DEEP''');v=json.loads('''$VMRAW''');b=json.loads('''$BAILIAN''')
print(json.dumps({'minimax':m,'tavily':t,'deepseek':d,'vm':v,'bailian':b},ensure_ascii=False,indent=2))
"
    else
        MINI=$(bash "$(run_module minimax)")
        fmt_minimax_human "$MINI"
        echo ''
        VMRAW=$(python3 "$(run_module vm)" 2>/dev/null || echo '{"error":"vm failed"}')
        fmt_vm_human "$VMRAW"
        echo ''
        TAVI=$(bash "$(run_module tavily)")
        fmt_tavily_human "$TAVI"
        echo ''
        DEEP=$(bash "$(run_module deepseek)" 2>/dev/null || echo '{"disabled":true,"reason":"默认禁用"}')
        fmt_deepseek_human "$DEEP"
        echo ''
        BAILIAN=$(python3 "$BAILIAN_CHECK" 2>/dev/null || echo '{"error":"bailian-check failed"}')
        fmt_bailian_human "$BAILIAN"
    fi
else
    if [[ "$MODULE" == "vm" ]]; then
        DATA=$(python3 "$(run_module vm)" 2>/dev/null)
        [[ "$MODE" == "json" ]] && { echo "$DATA"; } || fmt_vm_human "$DATA"
    elif [[ "$MODULE" == "bailian" ]]; then
        if [[ "$MODE" == "json" ]]; then
            python3 "$BAILIAN_CHECK"
        else
            DATA=$(python3 "$BAILIAN_CHECK")
            fmt_bailian_human "$DATA"
        fi
    elif [[ "$MODULE" == "bailian-guard" ]]; then
        python3 "$BAILIAN_GUARD"
    else
        DATA=$(bash "$(run_module $MODULE)" 2>/dev/null)
        [[ "$MODE" == "json" ]] && { echo "$DATA"; } || {
            case $MODULE in
                minimax)  fmt_minimax_human "$DATA" ;;
                tavily)   fmt_tavily_human "$DATA" ;;
                deepseek) fmt_deepseek_human "$DATA" ;;
            esac
        }
    fi
fi

exit 0
